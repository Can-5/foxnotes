{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fox Notes",
  "version": "1.0.0",
  "identifier": "app.foxnotes.personal",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fox Notes — yerel bilgi kasan",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#14100e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Yerel markdown bilgi kasası",
    "longDescription": "Fox Notes: notlarınızı ~/FoxNotes klasöründe düz .md dosyaları olarak saklayan, yerel öncelikli, Notion/Obsidian alternatifi markdown bilgi kasası. Çevrimdışı, hesapsız, sunucusuz.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
